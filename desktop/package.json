{
  "name": "veil-desktop",
  "productName": "VEIL Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop companion shell for the existing local VEIL Agent",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:windows": "electron tests/smoke.cjs",
    "package": "electron-packager . VEIL --platform=win32 --arch=x64 --out=dist --overwrite --tmpdir=.build --ignore=^/tests --ignore=^/dist --ignore=^/README.md --ignore=^/.npm-cache --ignore=^/.build --ignore=^/test-output"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "@electron/packager": "20.3.0"
  }
}
